# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/worktrees/

# WhatsApp chat exports (uploaded ad-hoc for satisfaction import; can be huge)
WhatsApp Chat*.zip
WhatsApp Chat*.txt
WhatsApp Unknown*.zip
WhatsApp Unknown*/

# Working scratch (videos, voiceovers, generated samples — never commit)
*.mp4
*.mp3
kling_*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stray media
*.ogg
supabase/.temp/
wa-lid-map.json
